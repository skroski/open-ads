# Configuração do servidor local. O jeito fácil de preencher é rodar: npm run setup
# (o assistente grava server/.env sozinho). Nunca cole estes valores em chats nem no Git.

# Cliente OAuth do Google Cloud (tipo "App para computador")
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Gerado pela autorização no navegador (npm run setup ou npm run token)
GOOGLE_ADS_REFRESH_TOKEN=
# Conta que abre por padrão (10 dígitos)
GOOGLE_ADS_CUSTOMER_ID=

# Opcional: conta administradora (MCC) pela qual o acesso chega à conta padrão.
# Contas de clientes com MCC diferente são cadastradas no próprio painel.
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Opcional (legado): token de desenvolvedor. Desde set/2026 o Google ignora este valor;
# o nível de acesso vem do projeto do Google Cloud dono do cliente OAuth.
# GOOGLE_ADS_DEVELOPER_TOKEN=

# Opcional:
# PORT=3000

# Opcional: Google Analytics 4, Search Console e Google Tag Manager. O refresh token do Google Ads serve
# se foi gerado com esses escopos (o npm run setup pergunta). Para usar contas Google
# diferentes, defina tokens próprios:
# GOOGLE_ANALYTICS_REFRESH_TOKEN=
# GOOGLE_SEARCH_CONSOLE_REFRESH_TOKEN=
# GOOGLE_TAG_MANAGER_REFRESH_TOKEN=

# Opcional: domínios que a leitura de páginas pode acessar (além dos que a conta anuncia).
# PAGE_AUDIT_ALLOWED_HOSTS=seusite.com.br,outrodominio.com

# Opcional: explicação por IA (Anthropic). Sem a chave, o painel usa só a explicação determinística.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Opcional: narração da ajuda guiada. Use apenas ao rodar `npm run help:audio`
# para gerar os MP3s locais. A chave não é necessária no painel publicado.
# FISH_AUDIO_API_KEY=
# FISH_AUDIO_REFERENCE_ID=
# FISH_AUDIO_MODEL=s2.1-pro-free

# Opcional (recomendado ao publicar online): código de acesso do painel. Com ele, a API só responde
# a quem enviar "Authorization: Bearer <código>"; o painel pede o código na primeira vez.
# Na Vercel, as ações que escrevem no Google Ads ficam bloqueadas enquanto ele não existir.
# PANEL_ACCESS_TOKEN=
