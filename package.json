{
  "name": "open-ads",
  "version": "1.0.0",
  "license": "GPL-2.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/dev.mjs",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "token": "node --env-file=server/.env server/get-refresh-token.mjs",
    "install:all": "npm install && npm --prefix web install",
    "build": "test -d web && (cd web && npm install && npm run build) || npm run build",
    "server": "node --env-file=server/.env server/index.mjs",
    "web": "cd web && npm start",
    "sync:api": "node scripts/sync-api.mjs",
    "help:audio": "node --env-file=server/.env scripts/generate-help-audio.mjs",
    "test:api": "node --test \"api/_lib/*.test.js\"",
    "check:api": "node scripts/sync-api.mjs --check",
    "check": "npm run check:api && npm run test:api && npm --prefix web test -- --watch=false && npm --prefix web run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0"
  },
  "engines": {
    "node": ">=20.6"
  }
}
