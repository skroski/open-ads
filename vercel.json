{
  "buildCommand": "test -d web && (cd web && npm install && npm run build) || npm run build",
  "outputDirectory": "web/dist/web/browser",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
